{
  "name": "@lexia/web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "predev": "pnpm --filter @lexia/shared build",
    "dev": "vite --host 0.0.0.0 --port 5173",
    "prebuild": "pnpm --filter @lexia/shared build",
    "build": "vite build",
    "preview": "vite preview",
    "format": "oxfmt",
    "verify:ui": "! grep -rnE '#[0-9a-fA-F]{3,6}' src/components src/ui src/hooks && ! grep -rnE 'rgba?\\(' src/components src/ui src/hooks && echo 'UI check OK: zero cores hardcoded em componentes'",
    "test": "tsx --test src/utils/sseParser.test.ts src/utils/sseFlow.test.ts src/utils/promocaoUI.test.ts",
    "pretest": "pnpm --filter @lexia/shared build"
  },
  "dependencies": {
    "@lexia/shared": "workspace:*",
    "@tiptap/extension-text-align": "^3.30.2",
    "@tiptap/extension-text-style": "^3.30.2",
    "@tiptap/pm": "^3.30.2",
    "@tiptap/react": "^3.30.2",
    "@tiptap/starter-kit": "^3.30.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "oxfmt": "^0.2.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.12",
    "typescript": "^5.7.0",
    "vite": "^8.0.0"
  }
}
